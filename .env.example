# ==========================================
# Royal Challengers SOC - Environment Template
# ==========================================
# Duplicate this file as .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.

# Flask Application
SECRET_KEY=your_random_secret_key_here

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/royal_challengers_db?retryWrites=true&w=majority

# Email Alerts (Brevo HTTP API)
BREVO_SMTP_KEY=your_brevo_api_key_here
ADMIN_EMAIL=your_admin_alert_email@example.com

# Twilio Alerts (Voice / SMS)
TWILIO_SID=your_twilio_account_sid_here
TWILIO_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE=+1234567890
MY_PHONE=+1234567890

# Threat Intelligence (AbuseIPDB)
ABUSEIPDB_KEY=your_abuseipdb_api_key_here

# Google reCAPTCHA v2 (Optional for login bot protection)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
